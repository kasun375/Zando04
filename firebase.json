{
  "functions": [
    {
      "source": "zando/functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log"
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/*.exe",
      "**/*.bat",
      "**/*.sh",
      "**/*.dll",
      "**/*.zip",
      "zando/**",
      "chrome-*/**",
      "payment-server/**"
    ],
    "rewrites": [
      {
        "source": "/create-payment-sheet-intent",
        "function": "api"
      },
      {
        "source": "/create-payment-intent",
        "function": "api"
      },
      {
        "source": "/api/**",
        "function": "api"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}

